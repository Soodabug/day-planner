# Copy to .env and fill in the values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL=

# Secret used to sign login tokens (long random string)
JWT_SECRET=

# Origin of the web app that may call this API, e.g. http://localhost:5174
WEB_ORIGIN=

# Web Push keys. Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services: a mailto: address or an https: URL
VAPID_SUBJECT=

# Email for "forgot password" (https://www.brevo.com, free plan).
# Without these two, reset links are printed in the server log instead of emailed.
BREVO_API_KEY=
# A sender address you verified in Brevo
EMAIL_FROM=

# Secret the cron service sends in the X-Cron-Secret header
# to POST /jobs/send-reminders (long random string)
CRON_SECRET=
